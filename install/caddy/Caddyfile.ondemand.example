# OpenQuick on-demand TLS edge example.
# Replace quick.example.com before use. Caddy's ask check calls the endpoint
# with ?domain=<requested-host>; quickd answers 200 only for cataloged domains
# from loopback/trusted-proxy peers.
{
	on_demand_tls {
		ask http://127.0.0.1:9366/_quick/domains/ask
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:9366
}

*.quick.example.com, quick.example.com {
	reverse_proxy 127.0.0.1:9366
}
